# Compte Cloudinary qui héberge les médias des annonces. Restreint les chemins
# autorisés par `next/image` (voir next.config.ts). Doit correspondre à
# CLOUDINARY_CLOUD_NAME côté API.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Secret partagé avec l'API (REVALIDATE_SECRET côté Laravel) pour signer le
# webhook de revalidation ISR. Une valeur différente des deux côtés fait échouer
# chaque publication en silence.
REVALIDATE_SECRET=
