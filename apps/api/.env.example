APP_NAME="Mecano API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false  # IMPORTANT: toujours false en production (BE-06)
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_FRONTEND_URL=https://web-mu-three-85.vercel.app
APP_ADMIN_URL=https://admin-nine-smoky-13.vercel.app
CORS_ALLOWED_ORIGINS=https://admin-nine-smoky-13.vercel.app,https://admin.garage.excellenceteam.site,https://web-mu-three-85.vercel.app,https://webgarage.excellenceteam.site
REVALIDATE_SECRET=change-me-to-a-secure-secret-key
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Port exposé par le conteneur sur l'hôte
# API_BIND: interface d'écoute (par défaut 127.0.0.1 = boucle locale seule)
# API_PORT: port seul, sans IP — NE PAS mettre 127.0.0.1:8000
API_BIND=127.0.0.1
API_PORT=8000

# Reverse proxies dont les en-tetes X-Forwarded-* sont honorees. Laisser vide
# pour la boucle locale et les plages privees (proxy sur la meme machine ou le
# meme reseau Docker). Ne jamais mettre `*` si l'API est joignable autrement
# que par son proxy : n'importe qui contournerait alors les limiteurs par IP.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Supabase PostgreSQL or Local MySQL/SQLite)
# For Supabase (Recommended for remote hosting):
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com  # or db.<project-ref>.supabase.co
# DB_PORT=6543                                    # 6543 (Pooler) or 5432 (Direct)
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require
# Or via direct URI:
# DB_URL="postgresql://postgres.<project-ref>:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Cloudinary (Photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mecano/dev/cars


# remove.bg (AI background removal)
REMOVE_BG_API_KEY=
REMOVE_BG_MONTHLY_QUOTA=50

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3001,admin.garage.com
